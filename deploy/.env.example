# Copiez ce fichier en deploy/.env puis adaptez-le (deploy/.env est ignoré par git).

# --- Domaines ---------------------------------------------------------------
# Domaine de base : les liens vivent sur BASE_DOMAIN et ses sous-domaines.
BASE_DOMAIN=example.com
# Le même domaine, points échappés (expression régulière Go de Traefik).
BASE_DOMAIN_REGEX=example\.com
# Domaine du panel d'administration (doit être BASE_DOMAIN ou un de ses sous-domaines).
BLINDER_ADMIN_DOMAIN=admin.example.com
BLINDER_ADMIN_TIME_ZONE=Europe/Paris

# --- Image ------------------------------------------------------------------
# BLINDER_IMAGE=ghcr.io/enimaloc/blinder
BLINDER_VERSION=latest

# --- Réseau -----------------------------------------------------------------
# Expression régulière Java du sous-réseau proxy de docker-compose.yml (172.30.0.0/24).
# Barres obliques simples : la valeur est lue telle quelle.
PROXY_SUBNET_REGEX=172\.30\.0\.\d{1,3}

# --- Base de données --------------------------------------------------------
POSTGRES_PASSWORD=change-me

# --- Certificat wildcard (challenge DNS Let's Encrypt) -----------------------
ACME_EMAIL=admin@example.com
# Fournisseur lego : https://go-acme.github.io/lego/dns/
ACME_DNS_PROVIDER=ovh

# Exemple OVH
OVH_ENDPOINT=ovh-eu
OVH_APPLICATION_KEY=
OVH_APPLICATION_SECRET=
OVH_CONSUMER_KEY=

# Exemple Cloudflare (ACME_DNS_PROVIDER=cloudflare)
# CF_DNS_API_TOKEN=

# --- Facultatif : GeoIP (fichier dans le volume /data) ------------------------
# BLINDER_GEOIP_DATABASE=/data/geoip/GeoLite2-City.mmdb

# --- Facultatif : e-mail (notifications) --------------------------------------
# SPRING_MAIL_HOST=smtp.example.com
# SPRING_MAIL_PORT=587
# SPRING_MAIL_USERNAME=
# SPRING_MAIL_PASSWORD=
# BLINDER_NOTIFICATIONS_MAIL_FROM=blinder@example.com
